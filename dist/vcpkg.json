{
    "name": "vcpkg",
    "version": "1.0.0",
    "builtin-baseline": "66c0373dc7fca549e5803087b9487edfe3aca0a1",
    "dependencies": [
        "libmagic",
        "freetype",
        "mbedtls",
        "zlib",
        "bzip2",
        "liblzma",
        "zstd",
        "curl",
        "libssh2",
        "md4c"
    ],
    "default-features": [ "glfw" ],
    "features": {
        "glfw": {
            "description": "Build with the GLFW window backend",
            "dependencies": [ "glfw3" ]
        },
        "sdl3": {
            "description": "Build with the SDL3 window backend",
            "dependencies": [
                {
                    "name": "sdl3",
                    "version>=": "3.4.0"
                }
            ]
        }
    }
}
